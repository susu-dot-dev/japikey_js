{
  "name": "@japikey/express",
  "version": "0.4.0",
  "description": "Express endpoints for JAPIKey authentication",
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "japikey",
    "apikey",
    "jwt",
    "jwks",
    "express"
  ],
  "homepage": "https://github.com/susu-dot-dev/japikey_js#readme",
  "bugs": {
    "url": "https://github.com/susu-dot-dev/japikey_js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/susu-dot-dev/japikey_js.git"
  },
  "license": "MIT",
  "author": "Anil Kulkarni",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write src/**/*.ts",
    "format:check": "prettier --check src/**/*.ts"
  },
  "devDependencies": {
    "@japikey/shared": "0.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "jose": "^6.2.17",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "supertest": "^7.3.2",
    "uuid": "^14.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@japikey/japikey": "0.4.0",
    "@japikey/authenticate": "0.4.0"
  },
  "peerDependencies": {
    "express": "^5.0.0"
  }
}
